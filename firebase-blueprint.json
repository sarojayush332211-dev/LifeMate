{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile, personalization preferences, and theme settings for LifeMate.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner."
        },
        "fullName": {
          "type": "string",
          "description": "User's chosen display name."
        },
        "email": {
          "type": "string",
          "description": "Google account email address."
        },
        "dateOfBirth": {
          "type": "string",
          "description": "Optional date of birth in YYYY-MM-DD format or empty string."
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile photo URL."
        },
        "dailyFocus": {
          "type": "string",
          "description": "User's primary daily focus or main goal."
        },
        "motivationStyle": {
          "type": "string",
          "enum": ["friendly", "strict", "goal_focused"],
          "description": "Preferred motivation tone."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether first-time profile setup has been completed."
        },
        "darkModeEnabled": {
          "type": "boolean",
          "description": "Saved dark theme preference."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Saved daily reminder preference."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "fullName", "motivationStyle", "onboardingCompleted", "darkModeEnabled", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "DailyTask": {
      "title": "DailyTask",
      "description": "A user's daily plan task.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Task title."
        },
        "notes": {
          "type": "string",
          "description": "Optional short note."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is completed."
        },
        "scheduledDate": {
          "type": "string",
          "description": "Scheduled date in YYYY-MM-DD format."
        },
        "completedDate": {
          "type": "string",
          "description": "Completion date in YYYY-MM-DD format or empty string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "title", "completed", "scheduledDate", "completedDate", "createdAt", "updatedAt"]
    },
    "ExpenseEntry": {
      "title": "ExpenseEntry",
      "description": "A personal expense entry tracked in INR.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "amount": {
          "type": "number",
          "description": "Expense amount in INR."
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Travel", "Shopping", "Education", "Entertainment", "Other"],
          "description": "Expense category."
        },
        "description": {
          "type": "string",
          "description": "Short expense description."
        },
        "expenseDate": {
          "type": "string",
          "description": "Expense date in YYYY-MM-DD format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "amount", "category", "expenseDate", "createdAt", "updatedAt"]
    },
    "PersonalGoal": {
      "title": "PersonalGoal",
      "description": "A personal measurable goal with current and target progress.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Goal name."
        },
        "targetAmount": {
          "type": "number",
          "description": "Target value."
        },
        "currentAmount": {
          "type": "number",
          "description": "Current progress value."
        },
        "unit": {
          "type": "string",
          "description": "Display unit such as ₹, pages, km, hrs, or %."
        },
        "targetDate": {
          "type": "string",
          "description": "Optional target date in YYYY-MM-DD format or empty string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "title", "targetAmount", "currentAmount", "unit", "createdAt", "updatedAt"]
    },
    "ActivityDay": {
      "title": "ActivityDay",
      "description": "Daily activity record used to compute genuine consistency streaks.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "dateKey": {
          "type": "string",
          "description": "Date key in YYYY-MM-DD format."
        },
        "completedTasksCount": {
          "type": "integer",
          "description": "Number of tasks completed on this day."
        },
        "engagementCount": {
          "type": "integer",
          "description": "Number of meaningful actions (tasks, goals, expenses) logged on this day."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "dateKey", "completedTasksCount", "engagementCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User-private profile and preference document."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "User's personal daily tasks."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseEntry" },
      "description": "User's personal expense entries."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/PersonalGoal" },
      "description": "User's personal goals."
    },
    "/users/{userId}/activity_days/{dateKey}": {
      "schema": { "$ref": "#/entities/ActivityDay" },
      "description": "User's daily activity logs for consistency streak calculation."
    }
  }
}
