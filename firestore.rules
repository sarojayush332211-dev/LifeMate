rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptionalDateKey(val) {
      return val is string && (val == '' || val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('dateOfBirth' in data) || isValidOptionalDateKey(data.dateOfBirth)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1024)) &&
             (!('dailyFocus' in data) || (data.dailyFocus is string && data.dailyFocus.size() <= 200)) &&
             data.motivationStyle in ['friendly', 'strict', 'goal_focused'] &&
             data.onboardingCompleted is bool &&
             data.darkModeEnabled is bool &&
             data.notificationsEnabled is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDailyTask(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.completed is bool &&
             isValidDateKey(data.scheduledDate) &&
             isValidOptionalDateKey(data.completedDate) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidExpenseEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 100000000 &&
             data.category in ['Food', 'Travel', 'Shopping', 'Education', 'Entertainment', 'Other'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
             isValidDateKey(data.expenseDate) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPersonalGoal(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 140 &&
             data.targetAmount is number &&
             data.targetAmount > 0 &&
             data.targetAmount <= 1000000000 &&
             data.currentAmount is number &&
             data.currentAmount >= 0 &&
             data.currentAmount <= 1000000000 &&
             data.unit is string &&
             data.unit.size() >= 1 &&
             data.unit.size() <= 20 &&
             (!('targetDate' in data) || isValidOptionalDateKey(data.targetDate)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidActivityDay(data, userId, dateKey) {
      return isValidDateKey(dateKey) &&
             data.userId is string &&
             data.userId == userId &&
             data.dateKey is string &&
             data.dateKey == dateKey &&
             data.completedTasksCount is int &&
             data.completedTasksCount >= 0 &&
             data.completedTasksCount <= 1000 &&
             data.engagementCount is int &&
             data.engagementCount >= 0 &&
             data.engagementCount <= 1000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'motivationStyle',
                         'onboardingCompleted', 'darkModeEnabled',
                         'notificationsEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'email', 'dateOfBirth',
                         'photoUrl', 'dailyFocus', 'motivationStyle',
                         'onboardingCompleted', 'darkModeEnabled',
                         'notificationsEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) && (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'fullName', 'email', 'dateOfBirth', 'photoUrl',
                           'dailyFocus', 'motivationStyle', 'onboardingCompleted',
                           'darkModeEnabled', 'notificationsEnabled', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'completed', 'scheduledDate',
                           'completedDate', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'notes', 'completed',
                           'scheduledDate', 'completedDate', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyTask(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidDailyTask(incoming(), userId) && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'notes', 'completed', 'scheduledDate',
                             'completedDate', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(expenseId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         incoming().keys().hasAll([
                           'userId', 'amount', 'category', 'expenseDate',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'amount', 'category', 'description',
                           'expenseDate', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidExpenseEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidExpenseEntry(incoming(), userId) && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'amount', 'category', 'description', 'expenseDate', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'targetAmount', 'currentAmount',
                           'unit', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'targetAmount', 'currentAmount',
                           'unit', 'targetDate', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPersonalGoal(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidPersonalGoal(incoming(), userId) && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'targetAmount', 'currentAmount',
                             'unit', 'targetDate', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      match /activity_days/{dateKey} {
        allow get: if isOwner(userId) && isValidId(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'completedTasksCount',
                           'engagementCount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'completedTasksCount',
                           'engagementCount', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidActivityDay(incoming(), userId, dateKey);

        allow update: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         isValidActivityDay(incoming(), userId, dateKey) && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'completedTasksCount', 'engagementCount', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(dateKey);
      }
    }
  }
}
